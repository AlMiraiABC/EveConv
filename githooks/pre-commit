#!/usr/bin/env sh
# Pre-commit hook to build the .NET solution before commit.
# This only runs on specific branches (main, master, dev).

set -eu

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

case "$current_branch" in
  main|master|dev)
    ;; # proceed
  *)
    printf "pre-commit: skipped on branch %s.\n" "$current_branch"
    exit 0
    ;;
esac

printf "pre-commit: running dotnet build...\n"

# Build solution
if dotnet build; then
  printf "pre-commit: dotnet build succeeded.\n"
else
  printf "pre-commit: dotnet build failed; aborting commit.\n"
  exit 1
fi

# Format codes
printf "pre-commit: formatting changed files...\n"
changed_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$' || true)

if [ -n "$changed_files" ]; then
  for file in $changed_files; do
    if [ -f "$file" ]; then
      dotnet format --include "$file"
      git add "$file" # Re-add the file to staging after formatting
    fi
  done
  printf "pre-commit: formatting completed.\n"
else
  printf "pre-commit: no C# files changed, skipping format.\n"
fi


root = true

charset = utf-8
insert_final_newline = true
indent_size = 4
tab_width = 4
end_of_line = lf
trim_trailing_whitespace = true
max_line_length = 120

[*.{cs,csx,vb,vbx,vbs}]
end_of_line = crlf
# IDE0290: 使用主构造函数
dotnet_diagnostic.IDE0290.severity = none


[*.{csproj,js,ts,jsx,tsx,json,html,css,scss,md}]
indent_size = 2
tab_width = 2
